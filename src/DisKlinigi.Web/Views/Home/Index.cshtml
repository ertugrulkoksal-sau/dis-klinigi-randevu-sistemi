@using DisKlinigi.Core.Domain
@model IReadOnlyList<Branch>
@{
    ViewData["Title"] = "Ana Sayfa";
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
                       DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<h1 class="h3 mb-3">Şubelerimiz</h1>
<p class="text-muted">
    Veriler ilk çalıştırmada otomatik oluşturulan SQLite veritabanından okunuyor: şubeler,
    çalışma saatleri ve bölümler ayrı tablolarda tutuluyor. Giriş ve randevu ekranları
    onaylı arayüz tasarımına göre 11 Kasım'dan itibaren ekleniyor.
</p>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Şube</th>
                <th>Adres</th>
                <th class="text-end">Ünit</th>
                <th>Çalışma saatleri</th>
                <th>Bölümler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var branch in Model)
            {
                <tr>
                    <td>@branch.Name<div class="small text-muted">@branch.City</div></td>
                    <td>@branch.Address</td>
                    <td class="text-end">@branch.ChairCount</td>
                    <td class="small">
                        @foreach (var day in days)
                        {
                            var hours = branch.GetWorkingHours(day);
                            <div>@TurkishNames.Day(day): @(hours?.ToString() ?? "Kapalı")</div>
                        }
                    </td>
                    <td class="small">@string.Join(", ", branch.Departments.Select(d => d.Name).Order())</td>
                </tr>
            }
        </tbody>
    </table>
</div>
