@using System.Security.Claims
@using DisKlinigi.Core.Domain
@{
    // Menü ve kullanıcı satırı çerezdeki bilgilerden geliyor. Tek ek sorgu personelin menüsündeki
    // onay kuyruğu sayısı (QueueCountViewComponent).
    var role = User.GetRole();
    var branchName = User.FindFirstValue(UserClaims.BranchName);
    var roleText = role is { } current
        ? TurkishNames.Role(current) + (branchName is null ? "" : $", {branchName}")
        : null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    // Bir akışın sonraki sayfaları (ör. randevu alırken tarih/saat) menüde ilk sayfasını seçili gösteriyor.
    var currentAction = ViewData["MenuAction"] as string ?? ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Diş Kliniği Randevu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 3c-2.5 0-4 2-4 4.5 0 3 1.5 5 2 8 .4 2.5 1 5.5 2.5 5.5s1.5-3 2.5-5c.5-1 1.5-1 2 0 1 2 1 5 2.5 5s2.1-3 2.5-5.5c.5-3 2-5 2-8C21 5 19.5 3 17 3c-2 0-3 1-5 1S9 3 7 3z" />
                </svg>
                <span>Diş Kliniği Randevu</span>
            </a>

            @if (role is { } r)
            {
                <nav class="main-menu" aria-label="Ana menü">
                    @foreach (var item in MainMenu.For(r))
                    {
                        var active = item.Controller == currentController && item.Action == currentAction;
                        <a asp-controller="@item.Controller" asp-action="@item.Action"
                           class="@(active ? "active" : null)" aria-current="@(active ? "page" : null)">@item.Text @if (item.Badge is { } badge)
                            {
                                @await Component.InvokeAsync(badge)
                            }</a>
                    }
                </nav>
                <div class="user-box">
                    <span>@User.Identity!.Name <span class="muted">· @roleText</span></span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="link-button">Çıkış</button>
                    </form>
                </div>
            }
            else if (ViewData["Branches"] is string branches)
            {
                <span class="muted small">@branches</span>
            }
        </div>
    </header>

    <main role="main" class="page">
        @if (TempData["Status"] is string status)
        {
            <div role="status" class="status-message">
                @if (TempData["StatusTitle"] is string statusTitle)
                {
                    <strong>@statusTitle</strong>
                }
                @status
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div role="alert" class="status-message status-error">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer-inner">BSM515 Nesneye Dayalı Programlama · 2026</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
