@model ComingSoonViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="page-title">@Model.Title</h1>
<p class="page-lead">@Model.Description</p>
<div class="empty-note">
    Bu ekran onaylı arayüz tasarımına göre <strong>@Model.PlannedDay</strong> günü kodlanacak.
    Şimdilik sadece kimlerin açabileceği belli: menüde gördüğünüz her bağlantı sizin rolünüze açık,
    diğer rollerin sayfaları adres yazılarak da açılmıyor.
</div>
