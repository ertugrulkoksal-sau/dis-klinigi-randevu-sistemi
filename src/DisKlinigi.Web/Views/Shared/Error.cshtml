@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="page-title">Bir hata oluştu</h1>
<p class="page-lead">İsteğiniz işlenirken beklenmeyen bir hata oldu. Sayfayı yenileyip tekrar deneyin.</p>

@if (Model.ShowRequestId)
{
    <p class="hint">İstek numarası: <code>@Model.RequestId</code></p>
}
